# Copy to .env and fill in. Never commit the real .env file.

# Long random string, e.g. python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Business details shown on the site (leave empty to hide)
BUSINESS_PHONE=
BUSINESS_EMAIL=
BUSINESS_AREA=
BUSINESS_KVK=

# Where contact-form messages are sent (defaults to BUSINESS_EMAIL)
CONTACT_RECIPIENT=

# Outgoing mail (SMTP). Example for Gmail with an app password:
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

# Set to 1 only for local development
FLASK_DEBUG=0
